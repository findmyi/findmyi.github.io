<view class="page">

  <view class="head">
    <view class="quote serif">「{{item.q}}」</view>
    <view class="act serif">{{item.act}}</view>
    <view class="meta">{{item.tag}} · {{item.time}}{{isB ? ' · 做完会得到一样东西' : ' · 一个动作'}}</view>
  </view>

  <view class="hr"></view>

  <view class="label">{{isB ? '步骤' : '现在就做'}}</view>

  <view class="steps">
    <view class="step" wx:for="{{item.steps}}" wx:for-item="s" wx:for-index="i" wx:key="*this">
      <view class="num serif">{{i + 1}}</view>
      <view class="step-t">{{s}}</view>
    </view>
  </view>

  <!-- B：这次要产出的东西，最值钱，用朱砂 -->
  <view class="blk duty" wx:if="{{isB}}">
    <view class="blk-label">这次要产出的东西</view>
    <view class="blk-text">{{item.out}}</view>
  </view>

  <!-- 为什么是这样 -->
  <view class="plain">
    <view class="plain-h">{{isB ? '执行提醒' : '为什么是这样'}}</view>
    <view class="plain-t">{{item.why}}</view>
  </view>

  <!-- B：写下来 -->
  <block wx:if="{{isB}}">
    <view class="label write-label">把它写在这里</view>
    <textarea
      class="ta"
      value="{{draft}}"
      bindinput="onDraft"
      placeholder="写多写少都行，只为以后能翻回来"
      placeholder-class="ta-ph"
      maxlength="-1"
      auto-height
      cursor-spacing="24"
    />
    <view class="save" hover-class="ghost-hover" bindtap="saveOut">
      <text>{{saved ? '已经存下了 · 点这里改' : '存进我的记录'}}</text>
    </view>
  </block>

  <!-- 完成 -->
  <view class="done {{isDone ? 'on' : ''}}" bindtap="toggleDone">
    <view class="done-k serif">{{isDone ? '已完成' : '照着做完了，点这里'}}</view>
    <view class="done-t">{{isDone ? '再点一下可以取消' : item.done}}</view>
  </view>

  <view class="home" wx:if="{{showHome}}" bindtap="goHome">
    <text>回到首页，挑你自己的处境 ›</text>
  </view>

</view>
