.wrap {
  min-height: 100vh;
  padding: 0 48rpx 60rpx;
  box-sizing: border-box;
  background: #fbf8f1;
}

/* ── 头部 ── */
.hero {
  padding: 96rpx 8rpx 0;
}

/* 朱砂小印：给全白版面一个落款 */
.seal {
  width: 60rpx;
  height: 60rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 28rpx;
  color: #a8322a;
  border: 1rpx solid #a8322a;
  border-radius: 3rpx;
  margin-bottom: 48rpx;
}

.eyebrow {
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: #9a9284;
  margin-bottom: 34rpx;
}

.title {
  font-size: 52rpx;
  line-height: 1.62;
  letter-spacing: 2rpx;
  color: #1c1a17;
  font-weight: 500;
}

.redrule {
  width: 56rpx;
  height: 2rpx;
  background: #a8322a;
  margin: 40rpx 0 34rpx;
}

.lede {
  font-size: 26rpx;
  line-height: 2;
  color: #6b645a;
}

/* ── 分区标题：一 / 二 ── */
.sec {
  margin-top: 72rpx;
}

.seclabel {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #a8a093;
  margin-bottom: 22rpx;
}

.seclabel .num {
  display: inline-block;
  width: 40rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  color: #a8322a;
  letter-spacing: 0;
}

/* ── 主入口：测一测 ── */
.main {
  padding: 40rpx 34rpx 36rpx;
  background: #fffdf8;
  border: 1rpx solid #e8e2d8;
  border-radius: 8rpx;
}

.main-t {
  font-size: 38rpx;
  letter-spacing: 2rpx;
  color: #1c1a17;
}

.main-d {
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.95;
  color: #6b645a;
}

.main-btn {
  margin-top: 34rpx;
}

/* ── 次入口：两个状态 ── */
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e8e2d8;
}

.row-hover {
  background: #f7f2e8;
}

.row-l {
  flex: 1;
}

.row-k {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #a8322a;
}

.row-t {
  margin-top: 10rpx;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  color: #1c1a17;
}

.row-m {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #a8a093;
}

.chev-r {
  width: 14rpx;
  height: 14rpx;
  margin-left: 20rpx;
  border-right: 1rpx solid #cfc7b8;
  border-top: 1rpx solid #cfc7b8;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ── 我的记录 ── */
.mine {
  display: flex;
  align-items: center;
  margin-top: 56rpx;
  padding: 32rpx 34rpx;
  background: #f6f1e6;
  border-radius: 8rpx;
}

.mine-hover {
  background: #efe8d9;
}

.mine-l {
  flex: 1;
}

.mine-t {
  font-size: 28rpx;
  letter-spacing: 1rpx;
  color: #1c1a17;
}

.mine-d {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #8d8579;
}

.tail {
  margin-top: 44rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.8;
  color: #b8b0a2;
}
