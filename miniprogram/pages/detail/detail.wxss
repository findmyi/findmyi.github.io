.page {
  min-height: 100vh;
  padding: 0 48rpx 60rpx;
  background: #fbf8f1;
}

/* ── 卦头 ── */
.head {
  padding: 56rpx 0 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hex {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 34rpx;
}

.ln {
  position: relative;
  width: 92rpx;
  height: 6rpx;
  margin-bottom: 10rpx;
}

.ln:last-child {
  margin-bottom: 0;
}

.ln.yang {
  background: #a89e8d;
}

.ln.yin::before,
.ln.yin::after {
  content: "";
  position: absolute;
  top: 0;
  width: 40rpx;
  height: 6rpx;
  background: #a89e8d;
}

.ln.yin::before {
  left: 0;
}

.ln.yin::after {
  right: 0;
}

.gname {
  font-size: 72rpx;
  letter-spacing: 8rpx;
  line-height: 1.3;
  color: #1c1a17;
  font-weight: 500;
}

.sub {
  margin-top: 20rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #a8a093;
}

.hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #c2baac;
}

/* ── 六爻 ── */
.rows {
  border-top: 1rpx solid #ece6da;
}

.row {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #ece6da;
}

.row-hover {
  background: #f7f2e8;
}

.rowhead {
  display: flex;
  align-items: flex-start;
}

.pos {
  width: 96rpx;
  flex-shrink: 0;
  padding-top: 5rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #a8322a;
}

.rv {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.72;
  letter-spacing: 1rpx;
  color: #1c1a17;
}

/* ── 展开 ── */
.detail {
  margin-top: 30rpx;
  padding-top: 6rpx;
  animation: unfold 0.22s ease-out both;
}

@keyframes unfold {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 展开后第一段不要顶得太高 */
.detail .blk:first-child {
  margin-top: 0;
}

.orig {
  margin-top: 28rpx;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: #b0a898;
}

.tail {
  padding: 52rpx 0 20rpx;
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #b8b0a2;
}
